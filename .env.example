# Use your own Qdrant Cloud endpoint and API key in a private .env file.
QDRANT_URL=https://<your-cloud-endpoint>
QDRANT_API_KEY=<your-api-key>
QDRANT_COLLECTION=document_chunks
JINA_API_KEY=
GROQ_API_KEY=
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<your-supabase-key>

# Optional retrieval tuning (dense+sparse hybrid with reciprocal rank fusion).
# RRF_K=60
# SEARCH_RRF_THRESHOLD=0.016
# BROAD_SEARCH_TOP_K=20
# SOURCE_SELECTION_RATIO=0.6
